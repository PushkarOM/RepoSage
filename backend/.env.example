# ============================================================================
# RepoSage backend configuration
# Copy this file to `.env` and fill in your keys. Anything left blank has a
# sensible default (see `app/core/config.py` for the full list and defaults).
#
# Generate a JWT secret with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# ============================================================================

# --- LLM provider -----------------------------------------------------------
# Choose "gemini" or "groq". Default is "gemini".
# LLM_PROVIDER=gemini

# Required when LLM_PROVIDER=gemini. Get one at https://aistudio.google.com
GOOGLE_API_KEY=
GOOGLE_MODEL_NAME=gemini-2.5-flash-lite

# Required when LLM_PROVIDER=groq. Groq has a more generous free tier and
# faster inference, which helps during dev iteration.
GROQ_API_KEY=
GROQ_MODEL_NAME=llama-3.3-70b-versatile

# --- Embeddings -------------------------------------------------------------
# "local" uses sentence-transformers (no key required). "openai" needs a key.
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL_LOCAL=sentence-transformers/all-MiniLM-L6-v2

# Required when EMBEDDING_PROVIDER=openai.
OPENAI_API_KEY=

# --- Database ---------------------------------------------------------------
# SQLite for local dev. Postgres for prod (e.g. Neon):
#   DATABASE_URL=postgresql://user:pass@host/dbname
DATABASE_URL=sqlite:///./reposage.db

# --- Redis (broker + checkpointer) ------------------------------------------
REDIS_URL=redis://localhost:6379/0

# --- Chroma (vector DB) -----------------------------------------------------
# When using docker-compose: CHROMA_HOST=chroma, CHROMA_PORT=8000.
# When using a host-mapped container: CHROMA_HOST=localhost, CHROMA_PORT=8001.
CHROMA_HOST=chroma
CHROMA_PORT=8000

# --- Cloned repos -----------------------------------------------------------
# Local directory the worker writes cloned repos into before ingestion.
CLONE_DIR=./cloned_repos

# --- Rate limits (per user, fixed-window 24h) -------------------------------
RATE_LIMIT_CHAT_PER_DAY=50
RATE_LIMIT_INGEST_PER_DAY=10

# --- JWT --------------------------------------------------------------------
# Two secrets: one for short-lived access tokens, one for long-lived refresh
# tokens. They MUST differ -- a refresh-token compromise should not let the
# attacker mint access tokens.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=
JWT_REFRESH_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_MINUTES=10080  # 7 days

# --- Cookies & CORS ---------------------------------------------------------
# Tokens are stored in httpOnly cookies -- not localStorage -- so a page-level
# XSS can't exfiltrate them. SameSite=Lax is the entire CSRF defense for same-
# origin requests; ensure the frontend + backend share an origin (via the Vite
# dev proxy or the nginx edge in Docker).
# Set COOKIE_SECURE=true once you're behind HTTPS.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# Comma-separated list of origins the browser is allowed to call from. With
# credentials enabled, wildcards are rejected by CORS -- be explicit.
CORS_ALLOWED_ORIGINS=["http://localhost","http://localhost:5173","http://localhost:8000"]

# --- GitHub OAuth (for private repos) ---------------------------------------
# Register an OAuth App at https://github.com/settings/developers.
# Authorization callback URL must match GH_REDIRECT_URI exactly.
# For the Docker Compose setup the frontend is served by nginx on port 80,
# so the callback goes through it: http://localhost/api/auth/github/callback.
# For bare-metal dev (no nginx), use the backend directly:
#   GH_REDIRECT_URI=http://localhost:8000/auth/github/callback
GH_CLIENT_ID=
GH_CLIENT_SECRET=
GH_REDIRECT_URI=http://localhost/api/auth/github/callback

# --- Frontend (used by the OAuth callback for the post-link redirect) -------
FRONTEND_BASE_URL=http://localhost
